{
  "name": "open-immersive-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,reader -c cyan,green \"npm run dev --workspace @oit/api\" \"npm run dev --workspace @oit/reader\"",
    "build": "npm run build --workspace @oit/reader && npm run build --workspace @oit/extension",
    "start": "npm run start --workspace @oit/api",
    "agent": "node scripts/agent-service.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.60.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19",
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.3",
    "concurrently": "^10.0.6",
    "@playwright/test": "^1.64.1"
  }
}
