# Copy to .env in the repository root. Keep credentials out of browser code.
PORT=8787
DATA_DIR=.data

# Local translation (install Ollama separately and pull this model).
TRANSLATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b

# Or set TRANSLATION_PROVIDER=google (Google Cloud Translation Basic, billing enabled).
# Create an API key restricted to the Cloud Translation API; keep it on the server.
GOOGLE_TRANSLATE_API_KEY=

# Or set TRANSLATION_PROVIDER=compatible for a compatible chat endpoint.
COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
COMPATIBLE_MODEL=local-model
COMPATIBLE_API_KEY=

# Basic handles text-layer PDFs. Optional Docling adds document recognition.
PARSER=basic
DOCLING_PYTHON=python3

# Local MCP service for coding agents (the API must already be running).
OIT_API_URL=http://127.0.0.1:8787
# Optional path-delimiter-separated directories for local file imports.
# Defaults to the agent service's working directory; stage user-selected uploads there.
# OIT_INPUT_ROOTS=/absolute/path/to/selected-document-folder
# Optional export directory; defaults to .data/agent-exports inside this repository.
# OIT_OUTPUT_DIR=/absolute/path/to/translation-outputs
