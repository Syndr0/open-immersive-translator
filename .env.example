# Copy to .env in the repository root. Keep credentials out of browser code.
PORT=8787
DATA_DIR=.data

# Local translation (install Ollama separately and pull this model).
TRANSLATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Or set TRANSLATION_PROVIDER=compatible for a compatible chat endpoint.
COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
COMPATIBLE_MODEL=local-model
COMPATIBLE_API_KEY=

# Basic handles text-layer PDFs. Optional Docling adds document recognition.
PARSER=basic
DOCLING_PYTHON=python3
